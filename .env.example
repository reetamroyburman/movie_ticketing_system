# Application
NODE_ENV=<enter_environment>          # e.g. development / production
PORT=<enter_port>                    # e.g. 4000

# Database
DB_HOST=<enter_db_host>              # e.g. localhost
DB_PORT=<enter_db_port>              # e.g. 3306
DB_USERNAME=<enter_db_username>
DB_PASSWORD=<enter_db_password>
DB_DATABASE=<enter_database_name>

# JWT Authentication

JWT_ACCESS_SECRET=<enter_access_secret>
JWT_REFRESH_SECRET=<enter_refresh_secret>
JWT_ACCESS_EXPIRES_IN=<enter_access_expiry>   # e.g. 15m
JWT_REFRESH_EXPIRES_IN=<enter_refresh_expiry> # e.g. 7d

# Rate Limiting
THROTTLE_TTL=<enter_ttl_seconds>     # e.g. 60
THROTTLE_LIMIT=<enter_request_limit> # e.g. 100
